{
  "name": "brainilab-web",
  "private": true,
  "version": "41.11.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "python3 tools/build-editorial.py && python3 tools/rebuild-bundles.py && node tools/build.mjs",
    "bundle": "python3 tools/rebuild-bundles.py",
    "deploy:checked": "node tools/deploy-verified.mjs",
    "editorial": "python3 tools/build-editorial.py",
    "test:review": "node tools/review-core.mjs --release-phase=launched"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "30.1.1",
    "postcss": "8.5.28"
  },
  "dependencies": {
    "sanitize-html": "2.17.7"
  }
}
