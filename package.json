{
  "name": "brainilab-web",
  "private": true,
  "version": "41.11.0",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build": "python3 tools/build-editorial.py && python3 tools/rebuild-bundles.py && node tools/build.mjs",
    "bundle": "python3 tools/rebuild-bundles.py",
    "deploy:checked": "node tools/deploy-verified.mjs",
    "editorial": "python3 tools/build-editorial.py",
    "test:review": "node tools/review-core.mjs --release-phase=launched",
    "web:guidance": "modern-web-guidance",
    "web:scan": "modern-web-guidance legacy-scan . --json",
    "tools:status": "node tools/brainilab-toolkit.mjs status",
    "audit:install": "pnpm --dir tools/web-audit install --frozen-lockfile --ignore-scripts",
    "audit:all": "node tools/web-audit/run.mjs all",
    "audit:kit": "node tools/web-audit/run.mjs kit",
    "audit:links": "node tools/web-audit/run.mjs links",
    "audit:test": "node tools/web-audit/test.mjs",
    "studio:seo": "node tools/brainilab-toolkit.mjs seo",
    "studio:images": "node tools/brainilab-toolkit.mjs images",
    "studio:voice": "node tools/brainilab-toolkit.mjs voice-server",
    "voice": "node tools/brainilab-toolkit.mjs voice"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "30.1.1",
    "modern-web-guidance": "1.0.1",
    "postcss": "8.5.28"
  },
  "dependencies": {
    "sanitize-html": "2.17.7"
  }
}
