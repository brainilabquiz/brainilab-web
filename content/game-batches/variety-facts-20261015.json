        },
        {
          "text": "Venus",
          "is_correct": true
        },
        {
          "text": "Mars",
          "is_correct": false
        }
      ],
      "fact_check": {
        "detail": "JPL absolute sidereal rotation243.018days; orbital0.61519726years. Mercury58.6462days/<88day orbit; Earth~1day/year; Mars~1day/year. Negative rotation indicates direction, not negative duration.",
