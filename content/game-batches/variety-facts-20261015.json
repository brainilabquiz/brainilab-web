    {
      "external_key": "variety-20261015-saturn-density",
      "topic_slug": "science",
      "difficulty": "medium",
      "prompt": "Which of these planets has a lower average density than water?",
      "explanation": "Saturn has an average density of about 0.69 g/cm³, below the usual 1 g/cm³ reference for liquid water. The other three are above 1.",
      "source_url": "https://ssd.jpl.nasa.gov/planets/phys_par.html",
      "tags": [],
      "options": [
        {
          "text": "Jupiter",
          "is_correct": false
        },
        {
          "text": "Saturn",
          "is_correct": true
        },
        {
          "text": "Uranus",
          "is_correct": false
        },
        {
          "text": "Neptune",
          "is_correct": false
        }
      ],
      "fact_check": {
        "detail": "JPL bulk density: Saturn0.6871, Jupiter1.3262, Uranus1.270, Neptune1.638 g/cm³. Water comparison uses the ordinary approximate1g/cm³ reference, not an exact temperature-independent constant.",
        "checked_at": "2026-10-15"
      }
    },
