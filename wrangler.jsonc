{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainilab-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "previews": {},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/learn", "/learn/*", "/sitemap.xml"],
    "not_found_handling": "404-page"
  }
}
