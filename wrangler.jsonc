{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainilab-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "previews": {},
  "triggers": {"crons": ["0 */12 * * *"]},
  "durable_objects": {"bindings": [{"name":"BREAKING_NEWS","class_name":"BreakingNewsStore"}]},
  "migrations": [{"tag":"breaking-news-v1","new_sqlite_classes":["BreakingNewsStore"]}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/learn", "/learn/*", "/sitemap.xml", "/about/", "/about/index.html"],
    "not_found_handling": "404-page"
  }
}
