{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brainilab-web",
  "main": "worker.js",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "previews": {},
  "triggers": {"crons": ["0 */12 * * *"]},
  "durable_objects": {"bindings": [{"name":"BREAKING_NEWS","class_name":"BreakingNewsStore"},{"name":"LEARN_PAGES","class_name":"LearnPageStore"}]},
  "migrations": [{"tag":"breaking-news-v1","new_sqlite_classes":["BreakingNewsStore"]},{"tag":"learn-pages-v1","new_sqlite_classes":["LearnPageStore"]}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/halloween", "/halloween/*", "/profile", "/profile/*", "/breaking-news", "/breaking-news/*", "/learn", "/learn/*", "/sitemap.xml", "/llms.txt", "/about", "/about/*", "/games", "/games/*", "/daily-quiz", "/daily-quiz/*", "/rankings", "/rankings/*", "/groups", "/groups/*", "/geography", "/geography/*", "/science", "/science/*", "/history", "/history/*", "/sports", "/sports/*", "/general-knowledge", "/general-knowledge/*", "/reasoning", "/reasoning/*", "/categories", "/categories/*", "/leaderboards", "/leaderboards/*"],
    "not_found_handling": "404-page"
  }
}
