/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: no-cache

/offline/*
  Cache-Control: no-store
  X-Robots-Tag: noindex

/assets/brand/app/*
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: no-cache


/ads.txt
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

/assets/icons/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/assets/flags/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=2592000

# Daily may be played inside the two exact Alldle origins only.
# Keep global X-Frame-Options: DENY as the legacy-browser fallback.
# Modern browsers enforce frame-ancestors instead. No wildcard ancestors.

